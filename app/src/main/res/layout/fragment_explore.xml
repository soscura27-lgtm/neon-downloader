<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Lo que no es la página: barra superior, descargas, "Escuchar" y la carga de la página -->
        <LinearLayout
            android:id="@+id/explore_chrome"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

        <!--
          Barra superior: apartados, buscador, y en la esquina el botón con TODAS las opciones de descarga
          (formato, descargar, escuchar, elegir vídeos, comentarios con GIF...). Así nada flota encima del
          vídeo ni tapa los botones de YouTube en los Shorts.
        -->
        <LinearLayout
            android:id="@+id/explore_top_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="2dp"
            android:paddingTop="6dp"
            android:paddingEnd="2dp"
            android:paddingBottom="6dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/explore_sections"
                style="?attr/materialIconButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="@string/sections_title"
                android:tooltipText="@string/sections_title"
                app:icon="@drawable/ic_grid"
                app:iconSize="24dp"
                app:iconTint="?attr/colorPrimary" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/explore_search_layout"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox.Dense"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                app:boxCornerRadiusBottomEnd="24dp"
                app:boxCornerRadiusBottomStart="24dp"
                app:boxCornerRadiusTopEnd="24dp"
                app:boxCornerRadiusTopStart="24dp"
                app:boxStrokeColor="?attr/colorPrimary"
                app:boxStrokeWidth="1dp"
                app:boxStrokeWidthFocused="2dp"
                app:endIconMode="clear_text"
                app:hintEnabled="false"
                app:startIconDrawable="@drawable/ic_search">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/explore_search"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/explore_search_hint"
                    android:imeOptions="actionSearch"
                    android:inputType="text"
                    android:maxLines="1"
                    android:textSize="15sp" />

            </com.google.android.material.textfield.TextInputLayout>

            <!-- Esquina: descargar (con el formato elegido debajo del icono) -->
            <LinearLayout
                android:id="@+id/explore_download_corner"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginStart="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:contentDescription="@string/explore_download_options"
                android:focusable="true"
                android:gravity="center"
                android:minWidth="52dp"
                android:orientation="vertical"
                android:paddingHorizontal="4dp"
                android:tooltipText="@string/explore_download_options">

                <ImageView
                    android:id="@+id/explore_download_icon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/baseline_download_24"
                    app:tint="?attr/colorSecondary" />

                <TextView
                    android:id="@+id/explore_download_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/neo_display"
                    android:importantForAccessibility="no"
                    android:maxLines="1"
                    android:textColor="?attr/colorSecondary"
                    android:textSize="9sp" />

            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/explore_more"
                style="?attr/materialIconButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="@string/more"
                app:icon="@drawable/baseline_more_vert_24"
                app:iconSize="24dp" />

        </LinearLayout>

        <!-- Nivel de descarga global (una franja fina): % del lote, cuántas van y cuántas faltan. Toca para ver la cola. -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/explore_dl_strip"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="12dp"
            android:layout_marginBottom="4dp"
            android:clickable="true"
            android:focusable="true"
            android:visibility="gone"
            app:cardBackgroundColor="?attr/colorSecondaryContainer"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp"
            app:strokeColor="?attr/colorPrimary"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:minHeight="30dp"
                    android:orientation="horizontal"
                    android:paddingStart="10dp"
                    android:paddingEnd="6dp">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/baseline_download_24"
                        app:tint="?attr/colorPrimary" />

                    <TextView
                        android:id="@+id/explore_dl_percent"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:minWidth="34dp"
                        android:textColor="?attr/colorPrimary"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/explore_dl_detail"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textColor="?attr/colorOnSecondaryContainer"
                        android:textSize="12sp" />

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:alpha="0.7"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_baseline_keyboard_arrow_right_24"
                        app:tint="?attr/colorOnSecondaryContainer" />

                </LinearLayout>

                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:id="@+id/explore_dl_bar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:indeterminate="false"
                    android:max="100"
                    app:trackCornerRadius="0dp"
                    app:trackThickness="3dp" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Reproductor de audio: solo aparece mientras suena algo (sigue en segundo plano) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/explore_player_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="12dp"
            android:layout_marginBottom="6dp"
            android:visibility="gone"
            app:cardBackgroundColor="?attr/colorSecondaryContainer"
            app:cardCornerRadius="24dp"
            app:cardElevation="0dp"
            app:strokeColor="?attr/colorPrimary"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:minHeight="48dp"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="4dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_headphones"
                    android:tint="?attr/colorPrimary" />

                <TextView
                    android:id="@+id/explore_player_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="?attr/colorOnSecondaryContainer"
                    android:textSize="14sp" />

                <ImageButton
                    android:id="@+id/explore_player_lyrics"
                    android:layout_width="40dp"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/neon_lyrics_open"
                    android:src="@drawable/ic_lyrics"
                    android:tint="?attr/colorOnSecondaryContainer" />

                <ImageButton
                    android:id="@+id/explore_player_prev"
                    android:layout_width="40dp"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/music_prev"
                    android:src="@drawable/ic_player_prev"
                    android:tint="?attr/colorOnSecondaryContainer" />

                <ImageButton
                    android:id="@+id/explore_player_play"
                    android:layout_width="40dp"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/music_play_pause"
                    android:src="@drawable/ic_player_pause"
                    android:tint="?attr/colorOnSecondaryContainer" />

                <ImageButton
                    android:id="@+id/explore_player_next"
                    android:layout_width="40dp"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/music_next"
                    android:src="@drawable/ic_player_next"
                    android:tint="?attr/colorOnSecondaryContainer" />

                <ImageButton
                    android:id="@+id/explore_player_stop"
                    android:layout_width="40dp"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/music_stop"
                    android:src="@drawable/ic_player_stop"
                    android:tint="?attr/colorOnSecondaryContainer" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/explore_progress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:indeterminate="false"
            android:max="100"
            android:visibility="invisible"
            app:trackThickness="2dp" />

        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <!--
              Aquí va el navegador (ExploreWebView, que puede seguir sonando en segundo plano). Se pone desde el código
              para conservarlo al girar el teléfono. Fondo negro: las bandas a los lados del vídeo a pantalla completa.
            -->
            <FrameLayout
                android:id="@+id/explore_web_holder"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@android:color/black" />

            <LinearLayout
                android:id="@+id/explore_error"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="?attr/colorSurface"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="24dp"
                android:visibility="gone">

                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/baseline_error_24"
                    app:tint="?attr/colorError" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center"
                    android:text="@string/explore_page_error"
                    android:textAppearance="?attr/textAppearanceBodyLarge" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/explore_retry"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/explore_retry" />

            </LinearLayout>

        </FrameLayout>

    </LinearLayout>

    <!-- Pantalla completa para el vídeo que se está reproduciendo -->
    <FrameLayout
        android:id="@+id/explore_fullscreen"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/black"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone" />

</FrameLayout>
