<?xml version="1.0" encoding="utf-8"?>
<!-- Letra: solo la letra de lo que suena (marcando la línea que va sonando si tiene tiempos), para leerla o copiarla -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/lyrics_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/lyrics_toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:navigationContentDescription="@string/neon_lyrics_close"
        app:navigationIcon="@drawable/ic_back"
        app:title="@string/neon_lyrics_title" />

    <!-- canción, artista y de dónde viene la letra -->
    <TextView
        android:id="@+id/lyrics_song"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:ellipsize="end"
        android:maxLines="2"
        android:textAppearance="?attr/textAppearanceTitleLarge"
        android:textStyle="bold"
        android:visibility="gone" />

    <TextView
        android:id="@+id/lyrics_artist"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textAppearance="?attr/textAppearanceBodyMedium"
        android:textColor="?attr/colorSecondary"
        android:visibility="gone" />

    <TextView
        android:id="@+id/lyrics_source"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:maxLines="2"
        android:textAppearance="?attr/textAppearanceLabelSmall"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:visibility="gone" />

    <!-- ajustar el tiempo (si la letra va adelantada o atrasada) -->
    <LinearLayout
        android:id="@+id/lyrics_offset_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="12dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_explore_hint"
        android:backgroundTint="?attr/colorSecondaryContainer"
        android:gravity="center"
        android:orientation="horizontal"
        android:visibility="gone">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/lyrics_offset_minus"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@string/neon_lyrics_offset_earlier"
            android:text="@string/neon_lyrics_offset_minus"
            android:textColor="?attr/colorOnSecondaryContainer" />

        <TextView
            android:id="@+id/lyrics_offset_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:minWidth="64dp"
            android:textAppearance="?attr/textAppearanceTitleSmall"
            android:textColor="?attr/colorOnSecondaryContainer" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/lyrics_offset_plus"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@string/neon_lyrics_offset_later"
            android:text="@string/neon_lyrics_offset_plus"
            android:textColor="?attr/colorOnSecondaryContainer" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/lyrics_offset_done"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/neon_lyrics_offset_done"
            android:textColor="?attr/colorOnSecondaryContainer" />

    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="4dp"
        android:layout_weight="1">

        <!-- la letra por líneas (la que suena, marcada) -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/lyrics_lines"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:overScrollMode="ifContentScrolls"
            android:visibility="gone" />

        <!-- la letra como texto, para elegir qué parte copiar -->
        <ScrollView
            android:id="@+id/lyrics_text_scroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <TextView
                android:id="@+id/lyrics_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:lineSpacingMultiplier="1.15"
                android:paddingHorizontal="24dp"
                android:paddingTop="12dp"
                android:paddingBottom="32dp"
                android:textColor="?attr/colorOnSurface"
                android:textIsSelectable="true"
                android:textStyle="bold" />

        </ScrollView>

        <!-- buscando, sin letra, sin conexión, nada sonando -->
        <LinearLayout
            android:id="@+id/lyrics_state"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="32dp"
            android:visibility="gone">

            <com.google.android.material.progressindicator.CircularProgressIndicator
                android:id="@+id/lyrics_loading"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:indeterminate="true" />

            <ImageView
                android:id="@+id/lyrics_state_icon"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:alpha="0.7"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_lyrics"
                android:visibility="gone" />

            <TextView
                android:id="@+id/lyrics_message"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:textAppearance="?attr/textAppearanceBodyLarge"
                android:textColor="?attr/colorOnSurfaceVariant" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/lyrics_state_action"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:visibility="gone" />

        </LinearLayout>

    </FrameLayout>

    <TextView
        android:id="@+id/lyrics_select_hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingHorizontal="16dp"
        android:paddingTop="4dp"
        android:text="@string/neon_lyrics_select_hint"
        android:textAppearance="?attr/textAppearanceLabelSmall"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:visibility="gone" />

    <!-- copiar toda la letra o pasar al texto para elegir una parte -->
    <LinearLayout
        android:id="@+id/lyrics_actions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:paddingVertical="8dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/lyrics_copy"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:enabled="false"
            android:text="@string/neon_lyrics_copy"
            app:icon="@drawable/ic_copy" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/lyrics_select"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:enabled="false"
            android:text="@string/neon_lyrics_select"
            app:icon="@drawable/ic_select_all" />

    </LinearLayout>

</LinearLayout>
